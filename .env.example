# Copy this file to .env.local. Never commit real secrets or API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenAI-compatible custom endpoint (base URL without /chat/completions)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL_ID=
CUSTOM_MODEL_NAME=Custom model
APP_URL=http://localhost:3000

# Optional legacy static single-node adapter (Aveiro web service only).
# Not required when using the dynamic Redis-backed provider registry.
# The remote provider also has its own independent environment file: provider-node/.env.example.
AVEIRO_PROVIDER_NODE_URL=
AVEIRO_NODE_ID=
AVEIRO_NODE_SECRET=
AVEIRO_COMMUNITY_MODEL_ID=
AVEIRO_COMMUNITY_MODEL_NAME=

# Persistent control-plane registry (Aveiro hosting only; server-side secrets).
# Use an HTTPS Upstash-compatible Redis REST endpoint.
AVEIRO_REDIS_REST_URL=
AVEIRO_REDIS_REST_TOKEN=
# 32 random bytes encoded as 64 hexadecimal characters; encrypts node HMAC secrets at rest.
AVEIRO_NODE_SECRET_ENCRYPTION_KEY=
# Random administrator bearer token (at least 32 characters); never expose it to the browser.
AVEIRO_ADMIN_TOKEN=
# Exact IDs only, after checkpoint-specific licence and deployment approval.
AVEIRO_APPROVED_COMMUNITY_MODELS=

