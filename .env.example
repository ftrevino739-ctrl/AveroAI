# Aveiro web application — server-side environment only.
# End users never configure, receive or enter model-provider API keys.
# Copy to .env.local for local development; keep real values out of Git.

# Durable account database (TLS required in production).
AVEIRO_DATABASE_URL=
AVEIRO_DATABASE_SSL=require
# Finite monthly request allowance for new accounts without an explicit account_limits row.
AVEIRO_DEFAULT_REQUESTS_PER_MONTH=100

# Canonical browser origin used by magic links and Origin/CSRF checks.
AVEIRO_AUTH_ORIGIN=http://localhost:3000
# SMTP delivery for account magic links. Use a verified sender domain in production.
AVEIRO_SMTP_HOST=
AVEIRO_SMTP_PORT=587
AVEIRO_SMTP_USER=
AVEIRO_SMTP_PASS=
AVEIRO_SMTP_FROM=
# Local development may opt into account protection; production is protected by default.
AVEIRO_REQUIRE_AUTH=false

# Persistent provider registry for Aveiro Community Compute.
# Use an HTTPS Upstash-compatible Redis REST endpoint.
AVEIRO_REDIS_REST_URL=
AVEIRO_REDIS_REST_TOKEN=
# 32 random bytes encoded as 64 hexadecimal characters; encrypts node HMAC secrets at rest.
AVEIRO_NODE_SECRET_ENCRYPTION_KEY=
# Random administrator bearer token (at least 32 characters); server-side only.
AVEIRO_ADMIN_TOKEN=
# Exact model IDs only, after checkpoint-specific licence and deployment approval.
AVEIRO_APPROVED_COMMUNITY_MODELS=
