# Copy this file to .env.local. Never commit real secrets or API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenAI-compatible custom endpoint (base URL without /chat/completions)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL_ID=
CUSTOM_MODEL_NAME=Custom model
APP_URL=http://localhost:3000

# Optional single Aveiro Community Compute node (server-side only).
# The same node ID and shared secret must be configured on the provider-node process.
# The node URL must use HTTPS outside local development.
AVEIRO_PROVIDER_NODE_URL=
AVEIRO_NODE_ID=
AVEIRO_NODE_SECRET=
AVEIRO_COMMUNITY_MODEL_ID=
AVEIRO_COMMUNITY_MODEL_NAME=
