# Wallet EVM dedicada en Base. Clave hex de 32 bytes con prefijo 0x.
# Nunca la subas a Git ni la expongas como NEXT_PUBLIC_*.
VENICE_WALLET_PRIVATE_KEY=

# Código privado compartido (mínimo 16 caracteres).
AVERO_ACCESS_CODE=

# Secreto aleatorio de sesión (mínimo 32 bytes).
AVERO_SESSION_SECRET=

# Genera un secreto aleatorio con PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
