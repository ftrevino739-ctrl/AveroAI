# Copy to the provider machine's private environment file.
# This file belongs to the invited remote GPU operator, not the Aveiro web app
# and never to an ordinary end user's device. Never commit real secrets.
AVEIRO_NODE_ID=
AVEIRO_NODE_SECRET=
AVEIRO_ALLOWED_MODELS=
LOCAL_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_INFERENCE_API_KEY=
AVEIRO_NODE_MAX_CONCURRENT=1
AVEIRO_NODE_REQUEST_TIMEOUT_MS=120000
PORT=8787

# Aveiro public HTTPS origin; set this to the deployed Aveiro web app URL.
AVEIRO_CONTROL_PLANE_URL=
AVEIRO_HEARTBEAT_INTERVAL_MS=30000
